{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": false,
    "schematicCollections": [
      "@angular-eslint/schematics"
    ]
  },
  "newProjectRoot": "projects",
  "projects": {
    "num-portal-webapp": {
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "configurations": {
            "deploy": {
              "budgets": [
                {
                  "maximumError": "15mb",
                  "maximumWarning": "10mb",
                  "type": "initial"
                },
                {
                  "maximumError": "20kb",
                  "maximumWarning": "6kb",
                  "type": "anyComponentStyle"
                }
              ],
              "buildOptimizer": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.deploy.ts"
                }
              ],
              "namedChunks": false,
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": true,
              "vendorChunk": false
            },
            "development": {
              "budgets": [
                {
                  "maximumError": "16mb",
                  "maximumWarning": "10mb",
                  "type": "initial"
                },
                {
                  "maximumError": "20kb",
                  "maximumWarning": "6kb",
                  "type": "anyComponentStyle"
                }
              ],
              "buildOptimizer": false,
              "extractLicenses": true,
              "namedChunks": true,
              "optimization": false,
              "sourceMap": true,
              "vendorChunk": true
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "allowedCommonJsDependencies": [
              "keycloak-js"
            ],
            "aot": true,
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "loader.js",
                "input": "node_modules/monaco-editor/min/vs",
                "output": "./vs/"
              },
              {
                "glob": "**/*",
                "input": "node_modules/monaco-editor/min/vs/editor",
                "output": "./vs/editor"
              },
              {
                "glob": "**/*",
                "input": "node_modules/monaco-editor/min/vs/base",
                "output": "./vs/base"
              }
            ],
            "index": "src/index.html",
            "main": "src/main.ts",
            "outputPath": "dist/num-portal-webapp",
            "polyfills": "src/polyfills.ts",
            "scripts": [],
            "styles": [
              "src/styles/styles.scss"
            ],
            "tsConfig": "tsconfig.app.json"
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "num-portal-webapp:build"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "deploy": {
              "buildTarget": "num-portal-webapp:build:development"
            },
            "development": {
              "buildTarget": "studio:build:development"
            },
            "mock": {
              "buildTarget": "num-portal-webapp:build:mock"
            }
          },
          "options": {
            "buildTarget": "num-portal-webapp:build",
            "proxyConfig": "proxy.conf.json"
          }
        }
      },
      "prefix": "num",
      "projectType": "application",
      "root": "",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "sourceRoot": "src"
    }
  },
  "version": 1
}