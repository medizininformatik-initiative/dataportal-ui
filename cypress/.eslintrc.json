{
  "overrides": [
    {
      "files": ["*.ts"],
      "parserOptions": {
        "project": ["./cypress/tsconfig.json"]
      },
      "rules": {
        "@typescript-eslint/no-unused-vars": [
          "warn",
          {
            "argsIgnorePattern": "^_"
          }
        ],
        "no-restricted-syntax": [
          "error",
          {
            "selector": "CallExpression[callee.name='defineStep'] MemberExpression[object.name='cy']",
            "message": "No cy.* in a step body. Put it in a method of this file's class and call that."
          },
          {
            "selector": "CallExpression[callee.name='defineStep'] :matches(CallExpression[callee.name='expect'], IfStatement, SwitchStatement, ThrowStatement)",
            "message": "No logic (expect/if/switch/throw) in a step body. Move it into a method of this file's class."
          },
          {
            "selector": "CallExpression[callee.name='defineStep'] BlockStatement[body.length>1]",
            "message": "A step body is one call on this file's class instance."
          },
          {
            "selector": "Literal[value=/data-cy/], TemplateElement[value.raw=/data-cy/]",
            "message": "No raw data-cy selector. Use dataCy() from support/dataCy.ts."
          },
          {
            "selector": "Program:has(CallExpression[callee.name='defineStep']):not(:has(ClassDeclaration))",
            "message": "A file with defineStep steps needs a class holding the cy.* code (see cypress/CLAUDE.md)."
          }
        ],
        "comment-format": "error",
        "no-duplicate-selector": "error",
        "jsdoc/require-jsdoc": [
          "error",
          {
            "publicOnly": false,
            "require": {
              "ClassDeclaration": true,
              "MethodDefinition": true,
              "FunctionDeclaration": true
            },
            "contexts": [
              "Program > VariableDeclaration > VariableDeclarator > :matches(ArrowFunctionExpression, FunctionExpression)",
              "ExportNamedDeclaration > VariableDeclaration > VariableDeclarator > :matches(ArrowFunctionExpression, FunctionExpression)"
            ],
            "checkConstructors": false
          }
        ],
        "jsdoc/require-description": [
          "error",
          {
            "contexts": ["any"]
          }
        ],
        "jsdoc/match-description": [
          "error",
          {
            "matchDescription": "^(?![\\s\\S]*\\b(?:[Aa]n?|[Tt]he|[Jj]ust|[Rr]eally|[Bb]asically|[Aa]ctually|[Ss]imply|[Vv]ery|[Pp]lease)\\b)[A-Z`][\\s\\S]*\\.$",
            "contexts": ["any"]
          }
        ],
        "jsdoc/no-bad-blocks": "error"
      }
    },
    {
      "files": ["support/dataCy.ts"],
      "rules": {
        "no-restricted-syntax": "off"
      }
    },
    {
      "files": ["support/commands.ts"],
      "rules": {
        "@typescript-eslint/no-namespace": "off",
        "@typescript-eslint/no-unused-vars": "off"
      }
    }
  ],
  "plugins": ["jsdoc"]
}
