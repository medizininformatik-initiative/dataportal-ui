{
  "root": true,
  "ignorePatterns": ["projects/**/*"],
  "overrides": [
    {
      "files": ["*.ts"],
      "plugins": ["import", "jsdoc"],
      "parserOptions": {
        "project": ["tsconfig.json", "cypress/tsconfig.json"],
        "createDefaultProgram": true
      },
      "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended", "plugin:@angular-eslint/recommended"],
      "rules": {
        "jsdoc/newline-after-description": "off",
        "jsdoc/require-jsdoc": [
          "warn",
          {
            "require": {
              "FunctionDeclaration": true,
              "MethodDefinition": true,
              "ArrowFunctionExpression": false,
              "FunctionExpression": false
            },
            "enableFixer": true
          }
        ],
        "jsdoc/require-description": "warn",
        "jsdoc/require-param": "warn",
        "jsdoc/require-param-type": "warn",
        "jsdoc/require-param-description": "off",
        "jsdoc/require-returns": "warn",
        "jsdoc/require-returns-type": "warn",
        "jsdoc/require-returns-description": "off",
        "jsdoc/check-param-names": "warn",
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-unused-vars": "warn",
        "@angular-eslint/no-empty-lifecycle-method": "off",
        "max-len": "off",
        "semi": 0,
        "import/order": ["warn", { "alphabetize": { "order": "asc", "caseInsensitive": true } }],
        "curly": ["error", "all"],
        "brace-style": ["error", "1tbs", { "allowSingleLine": false }],
        "@typescript-eslint/member-delimiter-style": [
          "error",
          {
            "multiline": {
              "delimiter": "none",
              "requireLast": false
            },
            "singleline": {
              "delimiter": "comma",
              "requireLast": true
            }
          }
        ],
        "@typescript-eslint/prefer-function-type": "error",
        "@typescript-eslint/typedef": ["warn", { "arrowParameter": true }],
        "no-restricted-syntax": [
          "warn",
          {
            "selector": "Property > CallExpression, ArrayExpression > CallExpression",
            "message": "Assign the call result to a const first, then pass the const into the object or array."
          }
        ],
        "@typescript-eslint/explicit-member-accessibility": [
          "error",
          {
            "accessibility": "explicit",
            "overrides": { "constructors": "no-public" }
          }
        ],
        "@angular-eslint/component-selector": [
          "error",
          {
            "type": "element",
            "prefix": "num",
            "style": "kebab-case"
          }
        ],
        "@angular-eslint/directive-selector": [
          "error",
          {
            "type": "attribute",
            "prefix": "num",
            "style": "camelCase"
          }
        ],
        "@typescript-eslint/naming-convention": [
          "error",
          {
            "selector": "default",
            "format": null
          },
          {
            "selector": "classProperty",
            "format": null
          }
        ],
        "@typescript-eslint/triple-slash-reference": [
          "off",
          {
            "path": "always",
            "types": "prefer-import",
            "lib": "always"
          }
        ],
        "@typescript-eslint/member-ordering": [
          "off",
          {
            "default": ["constructor", "public-decorated-field"]
          }
        ]
      }
    },
    {
      "files": ["*.component.ts", "*.directive.ts", "*.pipe.ts"],
      "rules": {
        "jsdoc/require-jsdoc": "off",
        "jsdoc/require-description": "off",
        "jsdoc/require-param": "off",
        "jsdoc/require-param-type": "off",
        "jsdoc/require-returns": "off",
        "jsdoc/require-returns-type": "off",
        "jsdoc/check-param-names": "off"
      }
    },
    {
      "files": ["*.html"],
      "extends": [
        "plugin:@angular-eslint/template/recommended",
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended",
        "plugin:@angular-eslint/recommended",
        "plugin:prettier/recommended"
      ],
      "rules": {}
    }
  ]
}
